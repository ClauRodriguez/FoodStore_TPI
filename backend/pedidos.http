@baseUrl = http://localhost:8000
@adminEmail = admin@foodstore.local
@adminPassword = Admin123!
@userEmail = pedido.u9@example.com
@userPassword = Usuario123!

### Login admin para crear producto
POST {{baseUrl}}/api/v1/auth/token
Content-Type: application/x-www-form-urlencoded

username={{adminEmail}}&password={{adminPassword}}

### Producto del pedido
# @name prodPedido
POST {{baseUrl}}/productos/
Content-Type: application/json

{"nombre":"Producto Pedido U9 {{$timestamp}}","descripcion":"","precio_base":100.0,"imagenes_url":[],"disponible":true}

### Registrar comprador
POST {{baseUrl}}/api/v1/auth/logout

### @name comprador
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{"nombre":"Comprador","apellido":"U9","email":"{{userEmail}}","password":"{{userPassword}}"}

### Login user
POST {{baseUrl}}/api/v1/auth/token
Content-Type: application/x-www-form-urlencoded

username={{userEmail}}&password={{userPassword}}

### Crear pedido: usuario_id sale de la sesión
# @name pedido
POST {{baseUrl}}/pedidos
Content-Type: application/json

{"detalles":[{"producto_id":{{prodPedido.response.body.id}},"cantidad":2}]}

### Obtener
GET {{baseUrl}}/pedidos/{{pedido.response.body.id}}

### Actualizar estado
PUT {{baseUrl}}/pedidos/{{pedido.response.body.id}}
Content-Type: application/json

{"estado":"CONFIRMADO"}

### Pedido con producto inexistente: 404 y rollback
POST {{baseUrl}}/pedidos
Content-Type: application/json

{"detalles":[{"producto_id":999999,"cantidad":1}]}

### Pedido sin detalles: 422
POST {{baseUrl}}/pedidos
Content-Type: application/json

{"detalles":[]}

### Borrado lógico
DELETE {{baseUrl}}/pedidos/{{pedido.response.body.id}}

### Eliminado: 404
GET {{baseUrl}}/pedidos/{{pedido.response.body.id}}
